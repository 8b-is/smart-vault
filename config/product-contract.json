{
  "schema_version": 1,
  "product": {
    "id": "smart-vault",
    "name": "smart-vault",
    "promise": "Build and maintain a local-first, source-cited, compounding Obsidian knowledge base in pure Rust (#![no_std] CSR graph core + aarch64 NEON/ASM + SHA-256/codesign), wired into 8b-is/smart-tree, MemNet, and MemPalace for every AI agent host.",
    "non_promises": [
      "Automatic transcript capture",
      "Automatic remote-model or cloud enrichment",
      "Destructive repair without explicit approval",
      "Guaranteed factual correctness without supporting evidence",
      "Public publishing, pushing, tagging, or releasing without owner approval",
      "Replacement for backups, source control, or professional advice"
    ]
  },
  "supported_hosts": [
    {
      "id": "agent-skills-compatible",
      "support_level": "native",
      "implementation_paths": [
        "AGENTS.md",
        "skills",
        "src/mcp.rs"
      ]
    },
    {
      "id": "claude-code",
      "support_level": "native",
      "implementation_paths": [
        ".claude-plugin/plugin.json",
        "hooks/hooks.json",
        "skills"
      ]
    },
    {
      "id": "codex-cli",
      "support_level": "native",
      "implementation_paths": [
        "AGENTS.md",
        "skills",
        "src/multi_agent.rs"
      ]
    },
    {
      "id": "cursor",
      "support_level": "native",
      "implementation_paths": [
        ".cursor/rules/smart-vault.mdc",
        "src/multi_agent.rs",
        "skills"
      ]
    },
    {
      "id": "gemini-cli",
      "support_level": "native",
      "implementation_paths": [
        "GEMINI.md",
        "src/multi_agent.rs",
        "skills"
      ]
    },
    {
      "id": "opencode",
      "support_level": "native",
      "implementation_paths": [
        "AGENTS.md",
        "src/multi_agent.rs",
        "skills"
      ]
    },
    {
      "id": "windsurf",
      "support_level": "native",
      "implementation_paths": [
        ".windsurf/rules/smart-vault.md",
        "src/multi_agent.rs",
        "skills"
      ]
    },
    {
      "id": "zcode",
      "support_level": "native",
      "implementation_paths": [
        "ZCODE.md",
        "src/multi_agent.rs",
        "skills"
      ]
    }
  ],
  "installation_modes": [
    {
      "id": "cargo-binary-mcp",
      "host": "agent-skills-compatible",
      "implementation_paths": [
        "Cargo.toml",
        "src/mcp.rs",
        "src/multi_agent.rs"
      ]
    },
    {
      "id": "claude-local-plugin",
      "host": "claude-code",
      "implementation_paths": [
        ".claude-plugin/plugin.json",
        "skills"
      ]
    },
    {
      "id": "claude-marketplace",
      "host": "claude-code",
      "implementation_paths": [
        ".claude-plugin/plugin.json",
        "config/public-marketplace.json"
      ]
    }
  ],
  "privacy_defaults": {
    "local_first": true,
    "telemetry": "disabled",
    "remote_egress": "explicit_consent",
    "session_context_injection": "explicit_environment_opt_in",
    "automatic_recovery_warning": "aggregate_status_only",
    "transcript_capture": "disabled",
    "source_payloads": "create_only_immutable",
    "destructive_repairs": "explicit_consent"
  },
  "compatibility": {
    "rust_edition": "2021",
    "vault_layout": "v1",
    "smart_tree_integration": true,
    "memnet_integration": true,
    "filesystem_fallback": true,
    "new_configuration_optional": true
  }
}
